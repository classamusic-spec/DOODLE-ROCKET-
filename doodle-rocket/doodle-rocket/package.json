{
  "name": "doodle-rocket",
  "version": "0.3.0",
  "private": true,
  "description": "Hand-drawn space learning game for ages 2 through Grade 3. Single-file HTML/SVG/JS prototype.",
  "scripts": {
    "start": "npx --yes serve app -l 5173",
    "check": "node scripts/check-syntax.mjs",
    "test": "npm run check && playwright test",
    "test:headed": "playwright test --headed",
    "shots": "playwright test -c playwright.shots.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
